# ============ 配置模板（复制为 .env 使用，但 API key 不要写在这里！）============
# API key 请通过环境变量注入：export DEEPSEEK_API_KEY=xxx
# 或在部署平台的 secret 管理中配置

# ============ Qdrant 向量库 ============
# url 留空 → 用 local mode（本地文件存储，无需 docker）
QDRANT__URL=
QDRANT__PATH=./data/qdrant
QDRANT__COLLECTION=enterprise_kb

# ============ Embedding（本地 bge-m3）============
EMBEDDING__MODEL=BAAI/bge-m3
EMBEDDING__DIM=1024
EMBEDDING__DEVICE=auto

# ============ 生成 LLM（经 LiteLLM）============
LLM__PRIMARY=deepseek/deepseek-flash
LLM__FALLBACK=claude-haiku-5-5
LLM__TEMPERATURE=0.0

# ============ 检索 / 切分 ============
RETRIEVAL__TOP_K=5
RETRIEVAL__CHUNK_SIZE=512
RETRIEVAL__CHUNK_OVERLAP=51

# ============ Reranker（本地 bge-reranker-v2-m3）============
RERANKER__MODEL=BAAI/bge-reranker-v2-m3
RERANKER__TOP_N=20

# ============ Langfuse 可观测（可选）============
LANGFUSE__ENABLED=false
LANGFUSE__PUBLIC_KEY=
LANGFUSE__SECRET_KEY=
LANGFUSE__HOST=https://cloud.langfuse.com
